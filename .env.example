ENVIRONMENT=development
DATABASE_URL=postgresql://postgres:secret_password@localhost:5432/surveydb
REDIS_URL=redis://localhost:6379/0
# Local implementation only; producer cutovers and worker activation are opt-in.
OUTBOX_V2_WORKER_ENABLED=false
OUTBOX_WORKER_ID=outbox-v2
APP_BUILD_ID=local
DURABLE_WEBRTC_ENABLED=false
DURABLE_LARK_ENABLED=false
DURABLE_MODERATION_ENABLED=false
DURABLE_DRIVE_ENABLED=false
DURABLE_APPEALS_ENABLED=false
# Provision an approved payout amount/policy separately; no built-in payout.
BILLING_POLICY_VERSION=configured-v1

# For recovery, set the same random secret on every app replica (32+ characters).
# APP_SECRET=
ADMIN_RECOVERY_EMAIL=admin@trustbridgevn.com
# Authenticated provider SMTP: port 587 + starttls, or 465 + implicit.
# admin@trustbridgevn.com is the default From address; the provider must authorize it.
# Leave credentials empty until provisioned. No development mail fallback.
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS_MODE=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=admin@trustbridgevn.com
# Set to the trusted reverse proxy's IP(s) only; never '*'.
FORWARDED_ALLOW_IPS=127.0.0.1

LARK_APP_ID=cli_mock_id
LARK_APP_SECRET=mock_secret
LARK_ENCRYPT_KEY=mock_encrypt_key
LARK_VERIFICATION_TOKEN=mock_token

TELEGRAM_BOT_TOKEN=mock_tg_token
TELEGRAM_WEBHOOK_SECRET=mock_webhook_secret

GEMINI_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=surveys
# Separate private bucket; never use the public CDN bucket for outbox evidence.
R2_PRIVATE_BUCKET_NAME=
R2_PUBLIC_URL_PREFIX=https://cdn.example.com

# Google Drive & Administrative Account
GOOGLE_ADMIN_EMAIL=admin@trustbridgevn.com
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_ACCESS_TOKEN=
