{
  "version": 1,
  "id": "date_range",
  "label": "Kiểm tra khoảng ngày",
  "description": "Kiểm tra độ dài khoảng ngày theo loại kỳ và tháng mục tiêu (bao gồm kỳ vắt qua tháng).",
  "implementation": "date_range",
  "params_schema": [
    {"key": "field", "label": "Trường dữ liệu", "type": "text", "default": "period_raw_text"},
    {"key": "granularity", "label": "Loại kỳ mong đợi", "type": "select", "options": ["DAILY", "WEEKLY", "MONTHLY", "QUARTERLY", "YEARLY"], "default": "WEEKLY"},
    {"key": "target_month", "label": "Tháng mục tiêu", "type": "month"}
  ],
  "conditions_schema": [
    {"key": "field", "label": "Trường dữ liệu", "type": "text", "required": true},
    {"key": "op", "label": "Điều kiện", "type": "select", "options": ["not_empty", "empty", "equals", "not_equals", "contains", "regex", "gte", "lte"], "required": true},
    {"key": "value", "label": "Giá trị so sánh", "type": "text"}
  ]
}
